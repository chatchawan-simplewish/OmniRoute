+import assert from "node:assert/strict";
+import test from "node:test";
+import { isAgentRouteAlias, runAgentRoute, type AgentRouteBindings } from "../../../open-sse/services/agentRoute.ts";
+
+const binding = (model: string, provider = "test") => ({ provider, model, connectionId: model });
+const bindings: AgentRouteBindings = {
+  vm1201: binding("q6"), bellPc: binding("q4"), free: [binding("a"), binding("b"), binding("c")],
+  codex: binding("gpt-5.6-sol", "codex"), codexNormal: binding("gpt-5.6-terra", "codex"),
+  cheapChineseReviewers: [binding("cheap")], strongChineseReviewers: [binding("strong")],
+};
+
+test("normal route uses the admitted local candidate and an independent reviewer", async () => {
+  const calls: string[] = [];
+  const result = await runAgentRoute({ alias: "agent/normal", bindings,
+    dispatch: async (target, options) => { calls.push(`${target.model}:${options.reviewer}`); return new Response("answer"); },
+    review: async () => "PASS",
+  });
+  assert.equal(result.verdict, "PASS");
+  assert.deepEqual(calls, ["q6:false", "cheap:true"]);
+});
+
+test("recognizes only approved controlled routing aliases", () => {
+  assert.equal(isAgentRouteAlias("agent/normal"), true);
+  assert.equal(isAgentRouteAlias("agent/high"), true);
+  assert.equal(isAgentRouteAlias("openrouter/auto"), false);
+});
